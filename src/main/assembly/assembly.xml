<?xml version="1.0" encoding="UTF-8"?>
<assembly
  xmlns="http://maven.apache.org/plugins/maven-assembly-plugin/assembly/1.1.2"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/plugins/maven-assembly-plugin/assembly/1.1.2 http://maven.apache.org/xsd/assembly-1.1.2.xsd">

  <id>bin</id>

  <formats>
    <format>zip</format>
  </formats>

  <includeBaseDirectory>false</includeBaseDirectory>

  <dependencySets>
    <dependencySet>
      <useProjectArtifact>false</useProjectArtifact>
      <outputDirectory>lib</outputDirectory>
      <excludes>
        <exclude>OpenRate:OpenRate</exclude>
      </excludes>
      <unpack>false</unpack>
    </dependencySet>
    
    <dependencySet>
      <useProjectArtifact>false</useProjectArtifact>
      <outputDirectory>ORlib</outputDirectory>
      <includes>
        <include>OpenRate:OpenRate</include>
      </includes>
      <unpack>false</unpack>
    </dependencySet>
  </dependencySets>

  <fileSets>
    <!-- Put the application jar in the "dist" folder -->
    <fileSet>
      <directory>${project.build.directory}</directory>
      <outputDirectory>dist</outputDirectory>
      <includes>
        <include>*.jar</include>
      </includes>
        <excludes>
          <exclude>src/main/resources/*.*</exclude>
        </excludes>
    </fileSet>

    <!-- Launcher scripts for the unpacked distribution -->
    <fileSet>
      <directory>src/main/bin</directory>
      <outputDirectory>bin</outputDirectory>
      <fileMode>0755</fileMode>
      <includes>
        <include>*.sh</include>
      </includes>
    </fileSet>

    <!-- Documentation and licence at the root of the distribution -->
    <fileSet>
      <directory>src/main/dist</directory>
      <outputDirectory>.</outputDirectory>
      <includes>
        <include>README.md</include>
      </includes>
    </fileSet>

    <fileSet>
      <directory>.</directory>
      <outputDirectory>.</outputDirectory>
      <includes>
        <include>LICENSE</include>
      </includes>
    </fileSet>

    <!-- Copy over all the config files we have -->
    <fileSet>
      <directory>src/main/resources</directory>
      <outputDirectory>properties</outputDirectory>
      <includes>
        <include>SeaSatCom.properties.xml</include>
        <include>logSeaSatCom.xml</include>
      </includes>
    </fileSet>

    <!-- The database dumps and stored procedures, so the distribution can
         be set up as shipped -->
    <fileSet>
      <directory>db-backups</directory>
      <outputDirectory>db</outputDirectory>
      <includes>
        <include>OR-DB-Backup-2009-12-30.zip</include>
        <include>JB-DB-Backup-2009-12-30.zip</include>
      </includes>
    </fileSet>

    <fileSet>
      <directory>ConfigData/SeaSatCom</directory>
      <outputDirectory>db</outputDirectory>
      <includes>
        <include>SP.sql</include>
      </includes>
    </fileSet>

    <!-- Sample traffic, so it can be tried out as shipped -->
    <fileSet>
      <directory>Data/SeaSatCom</directory>
      <outputDirectory>Data/SeaSatCom</outputDirectory>
      <includes>
        <include>*.zip</include>
      </includes>
    </fileSet>

    <!-- Configuration the balance handling reads at runtime -->
    <fileSet>
      <directory>src/main/resources/ConfigData/SeaSatCom</directory>
      <outputDirectory>ConfigData/SeaSatCom</outputDirectory>
      <includes>
        <include>BalanceConfig.dat</include>
      </includes>
    </fileSet>

  </fileSets>
</assembly>